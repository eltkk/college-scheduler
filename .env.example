# Use an alphanumeric database password (URL embedded in DATABASE_URL).
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC_SECRET
# Exact hostname without scheme or port. Keep loopback for healthchecks.
ALLOWED_HOSTS=schedule.example.org,localhost,127.0.0.1
SECURE_COOKIES=true
SOLVER_SECONDS=30
SOLVER_WORKERS=2
# Replace ALL passwords, minimum 12 characters. These accounts are created once.
BOOTSTRAP_USERS='[{"login":"editor1","name":"Редактор 1","password":"REPLACE_UNIQUE_PASSWORD_1"},{"login":"editor2","name":"Редактор 2","password":"REPLACE_UNIQUE_PASSWORD_2"},{"login":"editor3","name":"Редактор 3","password":"REPLACE_UNIQUE_PASSWORD_3"},{"login":"editor4","name":"Редактор 4","password":"REPLACE_UNIQUE_PASSWORD_4"}]'
